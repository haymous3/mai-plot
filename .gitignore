# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
dist/
build/
.venv/
venv/
env/
# .python-version IS committed — pins the workspace's Python version for uv

# Test / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# ---- Node / Next.js ----
node_modules/
.next/
out/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo/

# ---- Environment files ----
# Real env files (with secrets) are never committed.
# *.env.example IS committed — placeholders only.
.env
.env.local
.env.*.local
**/.env
!**/.env.example

# ---- Terraform ----
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# ---- Docker ----
# nothing to ignore in source tree; volumes mounted externally

# ---- IDE / OS ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
