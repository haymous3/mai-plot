# Maiplot web (admin dashboard) — SCRUM-59
# Base URL of auth-service, called server-side by the login route handler.
AUTH_SERVICE_URL=http://localhost:8011

# Comma-separated IP allowlist for the /admin surface. Empty = allow any
# (local/dev default). Production sets the office/VPN egress IPs; Kong enforces
# the same list at the edge — this app-level check is defence in depth.
ADMIN_IP_ALLOWLIST=
