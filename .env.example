# Maiplot — shared environment variable template
# Copy this file to .env and fill in real values. Never commit .env.
# Each service may also have its own .env.example with service-specific keys.

# ---------- Shared ----------
# One of: local | staging | production. Keep the comment on its own line —
# an inline `# ...` is NOT stripped by pydantic-settings and becomes part of
# the value (this silently broke the ENV=local gate on the dev-only routes).
ENV=local
LOG_LEVEL=INFO
AWS_REGION=af-south-1

# ---------- Database (PostgreSQL + PostGIS) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=maiplot
POSTGRES_USER=maiplot
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql+asyncpg://maiplot:change-me-local@postgres:5432/maiplot

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---------- Elasticsearch ----------
ELASTICSEARCH_URL=http://elasticsearch:9200

# ---------- S3 / CloudFront ----------
S3_BUCKET_DOCUMENTS=maiplot-documents-local
S3_BUCKET_MEDIA=maiplot-media-local
CLOUDFRONT_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- JWT ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ---------- Auth Service ----------
# SMS OTP via Twilio Programmable SMS (SCRUM-175, replaced Termii).
# Set TWILIO_USE_FAKE=false in staging/prod once real credentials are wired.
# NEVER put real values here — this file is committed. Real creds go in .env.
#
# DELIVERABILITY: TWILIO_FROM_NUMBER must be able to reach Nigerian mobiles.
# A US long code generally cannot — Nigerian carriers filter A2P long-code
# traffic under NCC rules and a registered alphanumeric sender ID is required.
# Twilio accepting a message is not evidence the handset received it.
TWILIO_USE_FAKE=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_BASE_URL=https://api.twilio.com
TWILIO_TIMEOUT_SECONDS=3.0
OTP_EXPIRE_MINUTES=5
OTP_RATE_LIMIT_PER_HOUR=5
JWT_ISSUER=maiplot-platform

# BVN verification (SCRUM-46). Fake verifier by default for local/CI.
# BVN_PEPPER is the HMAC key for the deterministic bvn_lookup dedup hash —
# a SERVER secret; set a long random value per environment and never rotate
# without re-deriving existing lookups. Set BVN_USE_FAKE=false + real bureau
# creds in staging/prod.
BVN_USE_FAKE=true
BVN_API_URL=
BVN_API_KEY=
BVN_TIMEOUT_SECONDS=5.0
BVN_PEPPER=change-me-to-a-long-random-bvn-pepper

# NIN verification (SCRUM-47). Owner-sellers only. Fake verifier by default.
# NIN_PEPPER is the HMAC key for the deterministic nin_lookup dedup hash —
# a SERVER secret; set a long random value per environment and never rotate
# without re-deriving existing lookups. Set NIN_USE_FAKE=false + real bureau
# creds in staging/prod.
NIN_USE_FAKE=true
NIN_API_URL=
NIN_API_KEY=
NIN_TIMEOUT_SECONDS=5.0
NIN_PEPPER=change-me-to-a-long-random-nin-pepper

# PoA document upload (SCRUM-48). PoA sellers upload a Power-of-Attorney doc
# to the PRIVATE documents bucket (S3_BUCKET_DOCUMENTS above); served later
# only via short-TTL pre-signed URLs. In-memory fake storage is default for
# local/CI. Set POA_STORAGE_USE_FAKE=false + real bucket/region in prod.
# POA_S3_ENDPOINT_URL is for localstack/minio in dev (blank = real AWS).
POA_STORAGE_USE_FAKE=true
POA_S3_BUCKET=maiplot-documents-local
POA_S3_REGION=af-south-1
POA_S3_ENDPOINT_URL=
POA_MAX_UPLOAD_BYTES=10485760
POA_PRESIGN_TTL_SECONDS=900

# ---------- Notification Service ----------
SES_FROM_EMAIL=noreply@maihomme.com
# FCM_SERVER_KEY is Phase 2 only — leave blank for now

# ---------- Payment (Paystack) ----------
# PAYSTACK_ENABLED=false wires the in-process fake charge client (dev/CI, no
# network). Set true + supply the keys below to hit the real Paystack API.
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Paystack REST base (override only for a sandbox/proxy); default api.paystack.co.
PAYSTACK_BASE_URL=https://api.paystack.co
# Where Paystack redirects the buyer after hosted checkout (frontend route).
PAYSTACK_CALLBACK_URL=

# ---------- Bank partners (one block per partner) ----------
BANK_001_API_URL=
BANK_001_API_KEY=

# ---------- Observability ----------
# Services emit OTLP to the OTel collector (gRPC port 4317); the collector
# fans out to Tempo (traces), Loki (logs), and Prometheus (metrics).
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Sentry handles error capture; tracing stays with OTel. Leave blank for
# local dev (init becomes a no-op). One shared DSN across services —
# server_name tag splits per-service error streams in the Sentry UI.
SENTRY_DSN=

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ---------- Host port overrides (rare) ----------
# Uncomment to remap docker-compose host ports if you have conflicts with
# other dev stacks on your machine. Internal container ports (and
# in-network service URLs above) are unchanged either way.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# LOKI_HOST_PORT=3100
