# Maiplot — shared environment variable template
# Copy this file to .env and fill in real values. Never commit .env.
# Each service may also have its own .env.example with service-specific keys.

# ---------- Shared ----------
ENV=local                                  # local | staging | production
LOG_LEVEL=INFO
AWS_REGION=af-south-1

# ---------- Database (PostgreSQL + PostGIS) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=maiplot
POSTGRES_USER=maiplot
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql+asyncpg://maiplot:change-me-local@postgres:5432/maiplot

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---------- Elasticsearch ----------
ELASTICSEARCH_URL=http://elasticsearch:9200

# ---------- S3 / CloudFront ----------
S3_BUCKET_DOCUMENTS=maiplot-documents-local
S3_BUCKET_MEDIA=maiplot-media-local
CLOUDFRONT_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- JWT ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ---------- Auth Service ----------
TERMII_API_KEY=
OTP_EXPIRE_MINUTES=5

# ---------- Notification Service ----------
SES_FROM_EMAIL=noreply@maiplot.ng
# FCM_SERVER_KEY is Phase 2 only — leave blank for now

# ---------- Payment (Paystack) ----------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ---------- Bank partners (one block per partner) ----------
BANK_001_API_URL=
BANK_001_API_KEY=

# ---------- Observability ----------
# Services emit OTLP to the OTel collector (gRPC port 4317); the collector
# fans out to Tempo (traces), Loki (logs), and Prometheus (metrics).
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
SENTRY_DSN=

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ---------- Host port overrides (rare) ----------
# Uncomment to remap docker-compose host ports if you have conflicts with
# other dev stacks on your machine. Internal container ports (and
# in-network service URLs above) are unchanged either way.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# LOKI_HOST_PORT=3100
